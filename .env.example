# ============================================================================
# FileZenith — environment variables
# ============================================================================
# Copy this file to `.env.local` (git-ignored) and fill in the values.
# Every variable prefixed with NEXT_PUBLIC_ is inlined into the client bundle
# at BUILD time, so changing one requires a rebuild + redeploy.
# ============================================================================


# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin. Used for metadata, sitemap, robots.txt, ads.txt and the
# OpenSearch description.
NEXT_PUBLIC_SITE_URL=https://www.filezenith.com

# Google Search Console verification token (from Search Console -> Settings ->
# Ownership verification -> HTML tag). Leave empty to omit the meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# ---------------------------------------------------------------------------
# Google AdSense
# ---------------------------------------------------------------------------
# Your publisher id, e.g. ca-pub-1291898061670715
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-1291898061670715

# Ad unit slot ids from the AdSense console (Ad units -> copy the numeric id).
#
# IMPORTANT — each of these is OPTIONAL, but if all three are left unset then
# NO manual ad units are rendered anywhere on the site (an <ins> without a
# valid data-ad-slot counts as an unfilled ad unit and degrades fill rate).
# AdSense Auto Ads still work regardless, because they only need the
# adsbygoogle.js loader in the document head.
#
#   NEXT_PUBLIC_ADSENSE_SLOT_HEADER         -> 728x90 responsive leaderboard
#   NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR        -> 300x600 responsive (sidebar)
#   NEXT_PUBLIC_ADSENSE_SLOT_POST_DOWNLOAD  -> 336x280 responsive (in-feed)
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_POST_DOWNLOAD=


# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Cloudflare Web Analytics token. Leave empty to disable the beacon.
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=


# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
# HTTPS endpoint that receives a JSON POST for each contact form submission
# (Formspree, Zapier, Make, Slack, Discord, a Resend/SendGrid proxy, ...).
# The payload is: { name, email, subject, message, source, receivedAt }
#
# If this is NOT set, the form shows a clear "delivery not configured" error
# and asks the visitor to email contact@filezenith.com instead. It never
# pretends a message was sent.
CONTACT_WEBHOOK_URL=
