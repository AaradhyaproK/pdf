{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdf",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "filezenith.com",
      "custom_domain": true
    },
    {
      "pattern": "www.filezenith.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
