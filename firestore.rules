rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'aaradhya1774@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // 1. Real-Time Live Visitors (Presence Heartbeat)
    match /live_visitors/{visitorId} {
      allow read, create, update, delete: if true;
    }

    // 2. Admin Settings & Master Ads Configuration
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write, create, update, delete: if true;
    }

    // 3. Analytics & Tool Execution Logs
    match /analytics_logs/{logId} {
      allow read, create, update, delete: if true;
    }

    // 4. Live Blog Posts Published via Admin Console
    match /blog_posts/{postId} {
      allow read: if true;
      allow write, create, update, delete: if true;
    }

    // 4. Analytics Summaries & Time-Based Metrics
    match /analytics_summary/{docId} {
      allow read, create, update, delete: if true;
    }

    match /daily_stats/{dateId} {
      allow read, create, update, delete: if true;
    }

    match /monthly_stats/{monthId} {
      allow read, create, update, delete: if true;
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
