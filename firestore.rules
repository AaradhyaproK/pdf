rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // FileZenith no longer uses Firebase at runtime.
    //
    // The admin console is a local, client-side tool backed by localStorage
    // (see lib/admin-store.ts) and blog posts are static MDX files in
    // /content/blog. These rules are therefore locked down completely so that
    // a stale deployment of this project cannot expose an open, writable
    // database.
    //
    // If Firebase is ever reintroduced, add explicit, least-privilege rules
    // for the specific collections that need them instead of reverting to a
    // blanket `allow read, write: if true`.
    // ---------------------------------------------------------------------

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'aaradhya1774@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Admin-only collections (kept locked, unused while Firebase is retired).
    match /admin_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /live_visitors/{visitorId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /analytics_logs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /analytics_summary/{docId} {
      allow read, write: if isAdmin();
    }

    match /daily_stats/{dateId} {
      allow read, write: if isAdmin();
    }

    match /monthly_stats/{monthId} {
      allow read, write: if isAdmin();
    }

    // Default fallback: deny everything.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
